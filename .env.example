# Port des Webservers
PORT=3000
# Google Maps API-Key (Directions + Geocoding API aktivieren). Ohne Key wird OpenStreetMap (Nominatim/OSRM) genutzt.
GOOGLE_MAPS_API_KEY=
# Geheimer Schlüssel zur Verschlüsselung der 2FA-Schlüssel (lange Zufallszeichenkette)
APP_SECRET=
# E-Mail des Betreibers – dieses Konto wird Admin und erhält die Provision
ADMIN_EMAIL=
# Preis pro gefahrenem Kilometer in Cent (Kostenteilung, max. Betriebskosten – siehe README)
RATE_PER_KM_CENTS=25
# Provision des Betreibers in Prozent vom Fahrpreis
COMMISSION_PERCENT=10
# Spende für Umweltschutz pro Fahrt in Cent
DONATION_CENTS_PER_RIDE=1
# Bestätigt nur eine Seite das Fahrtende, gilt die Fahrt nach so vielen Stunden als bestätigt
AUTO_CONFIRM_HOURS=24
# Gamification: Punkte = Faktor × CO2-Ersparnis (kg); Faktor nach Bewertung durch den Fahrtpartner
POINTS_FACTOR_PROMOTER=10
POINTS_FACTOR_NEUTRAL=5
POINTS_FACTOR_DETRACTOR=1
# Maximaler Umweg des Fahrers (Abstand Abholort/Ziel zur Route) in km
MAX_DETOUR_KM=3
