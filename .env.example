# Port des Webservers
PORT=3000
# Google Maps API-Key (Directions + Geocoding API aktivieren). Ohne Key wird OpenStreetMap (Nominatim/OSRM) genutzt.
GOOGLE_MAPS_API_KEY=
# Geheimer Schlüssel zur Verschlüsselung der 2FA-Schlüssel (lange Zufallszeichenkette)
APP_SECRET=
# E-Mail des Betreibers – dieses Konto wird Admin und erhält die Provision
ADMIN_EMAIL=
# Hinter einem Reverse-Proxy (nginx, Caddy, Load Balancer) auf 1 setzen – sonst leer lassen
TRUST_PROXY=
# Demo-Guthaben (ohne echte Zahlung) erlauben – im Livebetrieb auf 0 setzen
ALLOW_DEMO_TOPUP=1
# Kilometersatz aus Durchschnittswerten: Mitfahrer tragen ca. 2/3 der Energiekosten
# Ø-Kraftstoffpreis in Cent je Liter und Ø-Verbrauch in Litern je 100 km (regelmäßig aktualisieren)
AVG_FUEL_PRICE_CENTS_PER_LITER=175
AVG_CONSUMPTION_L_PER_100KM=7
RIDER_ENERGY_SHARE_PERCENT=67
# Optional: fester Kilometersatz in Cent statt der Berechnung
# RATE_PER_KM_CENTS=8
# ÖPNV-Richtwerte (Einzelticket in Cent) – nur als Vergleich in der Anzeige
TRANSIT_SHORT_CENTS=260
TRANSIT_CITY_CENTS=380
TRANSIT_REGION_CENTS=500
TRANSIT_PER_KM_BEYOND_CENTS=18
# Zusätzlich je Kilometer der gemeinsamen Strecke (je Person): Vermittlungsprovision und Umweltspende in Cent
COMMISSION_PER_KM_CENTS=5
DONATION_PER_KM_CENTS=5
# Identitätsprüfung: demo | postident | eid | idnow | veriff (außer demo: Adapter + Vertrag nötig, siehe README)
IDENT_PROVIDER=demo
# Weiterleitung zum Prüfdienst ({caseId} wird ersetzt) und Geheimnis für signierte Ergebnis-Meldungen
IDENT_START_URL=
IDENT_WEBHOOK_SECRET=
# Bestätigt nur eine Seite das Fahrtende, gilt die Fahrt nach so vielen Stunden als bestätigt
AUTO_CONFIRM_HOURS=24
# Gamification: Punkte = NPS-Wert der erhaltenen Bewertung (7–10; 4–6 → 1; 0–3 → 0) × CO2-Ersparnis (kg)
# Faktor, solange noch keine Bewertung vorliegt
POINTS_FACTOR_UNRATED=7
# Funfacts: Stadt/Marke erst ab so vielen verschiedenen Fahrern bzw. Bewertungen anzeigen
FUNFACTS_MIN_DRIVERS=2
FUNFACTS_MIN_RATINGS=3
# Nutzungsbedingungen: Teilnehmer mit Fahrtabbruchsquote über ABORT_QUOTE_LIMIT % (ab ABORT_MIN_RIDES Fahrten) werden dem Betreiber zur Prüfung angezeigt
ABORT_QUOTE_LIMIT=20
ABORT_MIN_RIDES=5
# Maximaler Umweg des Fahrers (Abstand Abholort/Ziel zur Route) in km
MAX_DETOUR_KM=3
