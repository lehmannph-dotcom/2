# Port des Webservers
PORT=3000
# Google Maps API-Key (Directions + Geocoding API aktivieren). Ohne Key wird OpenStreetMap (Nominatim/OSRM) genutzt.
GOOGLE_MAPS_API_KEY=
# Geheimer Schlüssel zur Verschlüsselung der 2FA-Schlüssel (lange Zufallszeichenkette)
APP_SECRET=
# E-Mail des Betreibers – dieses Konto wird Admin und erhält die Provision
ADMIN_EMAIL=
# Hinter einem Reverse-Proxy (nginx, Caddy, Load Balancer) auf 1 setzen – sonst leer lassen
TRUST_PROXY=
# Demo-Guthaben (ohne echte Zahlung) erlauben – im Livebetrieb auf 0 setzen
ALLOW_DEMO_TOPUP=1
# Preis pro gefahrenem Kilometer in Cent (Kostenteilung, max. Betriebskosten – siehe README)
RATE_PER_KM_CENTS=25
# Provision des Betreibers in Prozent vom Fahrpreis
COMMISSION_PERCENT=10
# Spende für Umweltschutz pro Fahrt in Cent
DONATION_CENTS_PER_RIDE=1
# Bestätigt nur eine Seite das Fahrtende, gilt die Fahrt nach so vielen Stunden als bestätigt
AUTO_CONFIRM_HOURS=24
# Gamification: Punkte = NPS-Wert der erhaltenen Bewertung (7–10; 4–6 → 1; 0–3 → 0) × CO2-Ersparnis (kg)
# Faktor, solange noch keine Bewertung vorliegt
POINTS_FACTOR_UNRATED=7
# Funfacts: Stadt/Marke erst ab so vielen verschiedenen Fahrern bzw. Bewertungen anzeigen
FUNFACTS_MIN_DRIVERS=2
FUNFACTS_MIN_RATINGS=3
# Nutzungsbedingungen: Teilnehmer mit Fahrtabbruchsquote über ABORT_QUOTE_LIMIT % (ab ABORT_MIN_RIDES Fahrten) werden dem Betreiber zur Prüfung angezeigt
ABORT_QUOTE_LIMIT=20
ABORT_MIN_RIDES=5
# Maximaler Umweg des Fahrers (Abstand Abholort/Ziel zur Route) in km
MAX_DETOUR_KM=3
